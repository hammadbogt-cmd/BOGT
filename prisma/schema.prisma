generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// USERS / AUTH / RBAC
// =========================================================================

enum UserRole {
  ADMIN
  INVENTORY_MANAGER
  PURCHASING
  WAREHOUSE
  FINANCE
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(VIEWER)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  auditLogs       AuditLog[]
  importJobs      ImportJob[]
  purchasePlans   PurchasePlan[]
  purchaseOrders  PurchaseOrder[]
  matchingReviews MatchingQueue[]
  settingsChanges SettingChange[]
  alertAcks       Alert[]         @relation("AlertAcknowledgedBy")

  @@map("users")
}

// =========================================================================
// PRODUCT MASTER + IDENTITY
// =========================================================================

enum CatalogSource {
  AMAZON_MAIN // "All PRODUCTS STATS"
  OA_USA // "OA USA Products"
  MANUAL
}

enum IdentifierType {
  BARCODE_PRIMARY
  BARCODE_ALTERNATE
  BARCODE_PREVIOUS
  BARCODE_SUPPLIER
  ASIN
  AMAZON_SKU
  OA_SKU
  SUPPLIER_SKU
}

enum ListingStatus {
  BUYBOX_WIN
  BUYBOX_WIN_LOW_PROFIT
  SELLING_AT_LOSS
  NO_BUYBOX
  INBOUND
  RESERVED
  UNFULFILLABLE
  OOS
  UNKNOWN
}

enum ReorderStatus {
  NO_REORDER
  MONITOR
  NEAR_OOS
  REORDER_REQUIRED
  HIGH_PRIORITY_REORDER
  SUPPLIER_AVAILABLE
  SUPPLIER_NOT_FOUND
  NOT_PROFITABLE_TO_REORDER
}

enum ProfitStatus {
  HIGH_PROFIT
  PROFITABLE
  LOW_PROFIT
  BREAK_EVEN
  LOSS
  UNKNOWN
}

model Product {
  id String @id @default(cuid())

  // identity (denormalized "primary" values for fast lookups; full history in ProductIdentifier)
  primaryBarcode String?
  asin           String?
  amazonSku      String?
  oaSku          String?
  supplierSku    String?

  brand         String?
  title         String
  imageUrl      String?
  catalogSource CatalogSource @default(AMAZON_MAIN)
  listingStatus ListingStatus @default(UNKNOWN)
  reorderStatus ReorderStatus @default(NO_REORDER)

  // Amazon current-state snapshot (latest values; history lives in AmazonStats)
  bsr                    Int?
  unitsShippedT30        Int?
  lastMonthSale          Int?
  amazonAvailableQty     Int      @default(0)
  amazonReservedQty      Int      @default(0)
  amazonInboundQty       Int      @default(0)
  amazonUnfulfillableQty Int      @default(0)
  buyBoxPrice            Decimal? @db.Decimal(12, 4)
  ourPrice               Decimal? @db.Decimal(12, 4)
  miniPrice              Decimal? @db.Decimal(12, 4)

  // warehouse current-state snapshot (also derivable from InventoryBalance; kept for fast reads)
  roverQty      Int @default(0)
  officeQty     Int @default(0)
  incomingPoQty Int @default(0)

  shelfLocation String?
  qtyPerBox     Int?
  totalBoxes    Int?
  looseQty      Int?

  // cost / pricing current-state
  currentCost           Decimal?  @db.Decimal(12, 4)
  currentCostWithVat    Decimal?  @db.Decimal(12, 4)
  lastPurchaseCost      Decimal?  @db.Decimal(12, 4)
  lastPurchaseDate      DateTime?
  weightedAvgCost       Decimal?  @db.Decimal(12, 4)
  lowestHistoricalCost  Decimal?  @db.Decimal(12, 4)
  highestHistoricalCost Decimal?  @db.Decimal(12, 4)
  firstPurchaseDate     DateTime?
  purchaseCount         Int       @default(0)
  lifetimePurchasedQty  Int       @default(0)

  fbaFee         Decimal?     @db.Decimal(12, 4)
  referralFee    Decimal?     @db.Decimal(12, 4)
  breakevenPrice Decimal?     @db.Decimal(12, 4)
  profitPerUnit  Decimal?     @db.Decimal(12, 4)
  roiPct         Decimal?     @db.Decimal(9, 4)
  marginPct      Decimal?     @db.Decimal(9, 4)
  profitStatus   ProfitStatus @default(UNKNOWN)

  inventoryValue Decimal? @db.Decimal(14, 4)

  preferredSupplierId String?
  preferredSupplier   Supplier? @relation(fields: [preferredSupplierId], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identifiers        ProductIdentifier[]
  sourceMappings     ProductSourceMapping[]
  amazonStats        AmazonStats[]
  salesHistory       SalesHistory[]
  inventoryBalances  InventoryBalance[]
  inventoryTxns      InventoryTransaction[]
  inventorySnapshots InventorySnapshot[]
  supplierProducts   SupplierProduct[]
  purchasePlanItems  PurchasePlanItem[]
  purchaseOrderItems PurchaseOrderItem[]
  invoiceItems       InvoiceItem[]
  purchaseHistory    PurchaseHistory[]
  reorderRecs        ReorderRecommendation[]
  alerts             Alert[]
  matchingCandidates MatchingQueue[]

  @@index([primaryBarcode])
  @@index([asin])
  @@index([amazonSku])
  @@index([oaSku])
  @@index([brand])
  @@index([reorderStatus])
  @@index([listingStatus])
  @@map("products")
}

model ProductIdentifier {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       IdentifierType
  value      String
  confidence String         @default("HIGH") // HIGH | MEDIUM | MANUAL_REVIEW
  source     String? // which import/tab this identifier came from
  createdAt  DateTime       @default(now())

  @@unique([type, value])
  @@index([value])
  @@map("product_identifiers")
}

model ProductSourceMapping {
  id                   String        @id @default(cuid())
  productId            String
  product              Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  source               CatalogSource
  sourceSku            String? // the SKU as it appears in that specific source tab
  sourceRowFingerprint String?
  createdAt            DateTime      @default(now())

  @@unique([source, sourceSku])
  @@map("product_source_mappings")
}

// =========================================================================
// AMAZON STATS HISTORY
// =========================================================================

model AmazonStats {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  source        CatalogSource
  effectiveDate DateTime      @default(now())
  isCurrent     Boolean       @default(true)

  brandName         String?
  listingStatus     String?
  bsr               Int?
  lastMonthSale     Int?
  unitsShippedT30   Int?
  inboundQty        Int?
  reservedQty       Int?
  unfulfillableQty  Int?
  availableQty      Int?
  availableQtyValue Decimal? @db.Decimal(14, 4)
  costPrice         Decimal? @db.Decimal(12, 4)
  costPriceWithVat  Decimal? @db.Decimal(12, 4)
  fbaFee            Decimal? @db.Decimal(12, 4)
  referralFee       Decimal? @db.Decimal(12, 4)
  breakevenPrice    Decimal? @db.Decimal(12, 4)
  buyBoxPrice       Decimal? @db.Decimal(12, 4)
  profitLoss        Decimal? @db.Decimal(12, 4)
  profitPct         Decimal? @db.Decimal(9, 4)
  roi               Decimal? @db.Decimal(9, 4)
  miniPrice         Decimal? @db.Decimal(12, 4)
  ourPrice          Decimal? @db.Decimal(12, 4)

  importJobId String?
  importJob   ImportJob? @relation(fields: [importJobId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId, isCurrent])
  @@index([productId, effectiveDate])
  @@map("amazon_stats")
}

enum SalesPeriod {
  T30
  T60
}

model SalesHistory {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  periodType  SalesPeriod
  unitsSold   Int
  periodEnd   DateTime
  isEstimated Boolean     @default(false)
  source      String?
  createdAt   DateTime    @default(now())

  @@index([productId, periodType, periodEnd])
  @@map("sales_history")
}

// =========================================================================
// INVENTORY LOCATIONS / BALANCES / TRANSACTIONS
// =========================================================================

enum LocationCode {
  AMAZON
  ROVER
  OFFICE
  INCOMING_PO
}

model InventoryLocation {
  id   String       @id @default(cuid())
  code LocationCode @unique
  name String

  balances     InventoryBalance[]
  transactions InventoryTransaction[]
  snapshots    InventorySnapshot[]

  @@map("inventory_locations")
}

model InventoryBalance {
  id         String            @id @default(cuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id])
  qty        Int               @default(0)
  updatedAt  DateTime          @updatedAt

  @@unique([productId, locationId])
  @@map("inventory_balances")
}

enum TxnDirection {
  IN
  OUT
}

enum TxnSourceType {
  STOCK_IN
  STOCK_OUT
  PO_RECEIPT
  ADJUSTMENT
  OPENING_BALANCE
}

model InventoryTransaction {
  id         String            @id @default(cuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id])

  direction       TxnDirection
  sourceType      TxnSourceType
  qty             Int
  transactionDate DateTime

  invoiceId         String? // Stock_IN "Invoice ID"
  shipmentReference String? // Stock_OUT "Shipment Reference"
  fcDestination     String?
  newCostPrice      Decimal? @db.Decimal(12, 4)
  oldCostPrice      Decimal? @db.Decimal(12, 4)
  brand             String?
  productTitleRaw   String?
  barcodeRaw        String?
  remarks           String?

  // idempotency key so re-syncing the same sheet rows never duplicates transactions
  fingerprint String @unique

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  importJobId String?
  importJob   ImportJob? @relation(fields: [importJobId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId, transactionDate])
  @@index([locationId, transactionDate])
  @@map("inventory_transactions")
}

model InventorySnapshot {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId    String
  location      InventoryLocation @relation(fields: [locationId], references: [id])
  qty           Int
  valuationCost Decimal?          @db.Decimal(14, 4)
  snapshotDate  DateTime

  @@index([productId, snapshotDate])
  @@map("inventory_snapshots")
}

// =========================================================================
// SUPPLIERS
// =========================================================================

model Supplier {
  id           String    @id @default(cuid())
  name         String    @unique
  contactName  String?
  contactEmail String?
  contactPhone String?
  currency     String    @default("AED")
  moq          Int?
  casePack     Int?
  leadTimeDays Int?
  priority     Int       @default(100) // lower = higher priority when tie-breaking
  notes        String?
  lastUpdateAt DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  products             SupplierProduct[]
  purchasePlanItems    PurchasePlanItem[]
  purchaseOrders       PurchaseOrder[]
  invoices             Invoice[]
  inventoryTxns        InventoryTransaction[]
  preferredForProducts Product[]

  @@map("suppliers")
}

model SupplierProduct {
  id           String   @id @default(cuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSku  String?
  price        Decimal  @db.Decimal(12, 4)
  currency     String   @default("AED")
  stockQty     Int?
  moq          Int?
  casePack     Int?
  leadTimeDays Int?
  lastUpdated  DateTime @default(now())
  isActive     Boolean  @default(true)

  priceHistory SupplierPriceHistory[]

  @@unique([supplierId, productId])
  @@map("supplier_products")
}

model SupplierPriceHistory {
  id                String          @id @default(cuid())
  supplierProductId String
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  price             Decimal         @db.Decimal(12, 4)
  effectiveDate     DateTime        @default(now())
  source            String? // "manual" | "csv_import" | "sheet_sync"
  importJobId       String?

  @@index([supplierProductId, effectiveDate])
  @@map("supplier_price_history")
}

// =========================================================================
// PURCHASE PLANS / PURCHASE ORDERS
// =========================================================================

enum PurchasePlanItemStatus {
  SUGGESTED
  REVIEWING
  APPROVED
  ORDERED
  PARTIALLY_ORDERED
  AWAITING_INVOICE
  INVOICED
  RECEIVED
  CANCELLED
}

model PurchasePlan {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("DRAFT")
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PurchasePlanItem[]

  @@map("purchase_plans")
}

model PurchasePlanItem {
  id         String       @id @default(cuid())
  planId     String
  plan       PurchasePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  supplierId String?
  supplier   Supplier?    @relation(fields: [supplierId], references: [id])

  systemRecommendedQty Int // never overwritten once set
  userFinalQty         Int?
  supplierStockQty     Int?
  supplierPrice        Decimal? @db.Decimal(12, 4)
  expectedTotalCost    Decimal? @db.Decimal(14, 4)
  expectedProfit       Decimal? @db.Decimal(14, 4)
  roiPct               Decimal? @db.Decimal(9, 4)
  notes                String?

  status PurchasePlanItemStatus @default(SUGGESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poItems PurchaseOrderItem[]

  @@map("purchase_plan_items")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  poNumber         String              @unique
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  orderDate        DateTime            @default(now())
  status           PurchaseOrderStatus @default(DRAFT)
  expectedDelivery DateTime?
  invoiceReference String?
  createdById      String?
  createdBy        User?               @relation(fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  items    PurchaseOrderItem[]
  invoices Invoice[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id            String            @id @default(cuid())
  poId          String
  po            PurchaseOrder     @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  planItemId    String?
  planItem      PurchasePlanItem? @relation(fields: [planItemId], references: [id])
  qtyOrdered    Int
  unitCost      Decimal           @db.Decimal(12, 4)
  expectedTotal Decimal           @db.Decimal(14, 4)
  receivedQty   Int               @default(0)

  @@map("purchase_order_items")
}

// =========================================================================
// INVOICES / INVOICE CHECKER
// =========================================================================

enum InvoiceStatus {
  UPLOADED
  MATCHING
  REVIEWED
  APPROVED
  RECEIVED
  REJECTED
}

model Invoice {
  id              String         @id @default(cuid())
  invoiceNumber   String
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  invoiceDate     DateTime?
  fileName        String?
  fileType        String? // csv | xlsx | pdf | sheet
  status          InvoiceStatus  @default(UPLOADED)
  importJobId     String?
  importJob       ImportJob?     @relation(fields: [importJobId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items InvoiceItem[]

  @@map("invoices")
}

enum InvoiceLineStatus {
  PRICE_OK
  PRICE_DECREASED
  PRICE_INCREASED
  LARGE_PRICE_INCREASE
  LOW_PROFIT
  LOSS
  BETTER_SUPPLIER_AVAILABLE
  QTY_DIFFERENCE
  UNKNOWN_PRODUCT
  BARCODE_NOT_MATCHED
  REVIEW_REQUIRED
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  barcodeRaw String?
  asinRaw    String?
  skuRaw     String?
  titleRaw   String?

  invoiceQty   Int
  invoicePrice Decimal @db.Decimal(12, 4)

  lastPurchasePrice        Decimal? @db.Decimal(12, 4)
  weightedAvgPrice         Decimal? @db.Decimal(12, 4)
  lowestHistoricalPrice    Decimal? @db.Decimal(12, 4)
  currentMasterCost        Decimal? @db.Decimal(12, 4)
  bestCurrentSupplierPrice Decimal? @db.Decimal(12, 4)
  priceDiff                Decimal? @db.Decimal(12, 4)
  priceDiffPct             Decimal? @db.Decimal(9, 4)
  currentSellingPrice      Decimal? @db.Decimal(12, 4)
  estFbaFee                Decimal? @db.Decimal(12, 4)
  referralFee              Decimal? @db.Decimal(12, 4)
  profit                   Decimal? @db.Decimal(12, 4)
  roiPct                   Decimal? @db.Decimal(9, 4)

  status InvoiceLineStatus @default(REVIEW_REQUIRED)

  linkedPoItemId String?
  createdAt      DateTime @default(now())

  @@map("invoice_items")
}

// PurchaseHistory: denormalized rollup view built from InventoryTransaction (STOCK_IN) for fast product-360 reads
model PurchaseHistory {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  transactionId String   @unique
  date          DateTime
  invoiceId     String?
  supplierId    String?
  supplierName  String?
  barcodeRaw    String?
  qty           Int
  newCost       Decimal  @db.Decimal(12, 4)
  previousCost  Decimal? @db.Decimal(12, 4)
  priceDiff     Decimal? @db.Decimal(12, 4)
  priceDiffPct  Decimal? @db.Decimal(9, 4)
  source        String?
  importJobId   String?

  @@index([productId, date])
  @@map("purchase_history")
}

// =========================================================================
// REORDER ENGINE
// =========================================================================

enum ReorderPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ReorderRecommendation {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  computedAt DateTime @default(now())

  bsr            Int?
  t30Sales       Int?
  t60Sales       Int?
  t60IsEstimated Boolean  @default(false)
  avgDailySales  Decimal? @db.Decimal(10, 4)

  amazonQty    Int
  roverQty     Int
  officeQty    Int
  incomingQty  Int
  netAvailable Int

  daysOfStock Decimal? @db.Decimal(10, 2)
  stockStatus String? // OOS | CRITICAL | NEAR_OOS | LOW_STOCK | HEALTHY

  targetDemand30   Int
  recommendedQty30 Int
  targetDemand60   Int
  recommendedQty60 Int

  priority      ReorderPriority @default(NONE)
  reorderStatus ReorderStatus   @default(NO_REORDER)

  bestSupplierId        String?
  bestSupplierPrice     Decimal? @db.Decimal(12, 4)
  expectedProfitPerUnit Decimal? @db.Decimal(12, 4)
  expectedRoiPct        Decimal? @db.Decimal(9, 4)

  breakdown Json // transparency payload: { targetDemand, amazon, rover, office, incoming, netAvailable, formula }

  isLatest Boolean @default(true)

  @@index([productId, isLatest])
  @@index([reorderStatus])
  @@index([priority])
  @@map("reorder_recommendations")
}

// =========================================================================
// ALERTS
// =========================================================================

enum AlertType {
  AMAZON_OOS
  NEAR_OOS
  LOW_DAYS_STOCK
  HIGH_SALES_LOW_STOCK
  BSR_REORDER_NEEDED
  SUPPLIER_STOCK_FOR_OOS
  SUPPLIER_PRICE_DROPPED
  SUPPLIER_PRICE_INCREASED
  SELLING_AT_LOSS
  ROI_BELOW_THRESHOLD
  INVOICE_PRICE_INCREASED
  BETTER_SUPPLIER_AVAILABLE
  DUPLICATE_BARCODE
  MISSING_ASIN
  UNKNOWN_BARCODE
  NEGATIVE_WAREHOUSE_STOCK
  HIGH_INVENTORY_NO_SALES
  OVERSTOCK
  SOURCE_MAPPING_ISSUE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id       String        @id @default(cuid())
  type     AlertType
  severity AlertSeverity @default(WARNING)
  status   AlertStatus   @default(OPEN)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  message  String
  metadata Json?

  acknowledgedById String?
  acknowledgedBy   User?     @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status, severity])
  @@index([type])
  @@map("alerts")
}

// =========================================================================
// IMPORT / SYNC ENGINE
// =========================================================================

enum ImportSourceType {
  CSV
  XLSX
  GOOGLE_SHEETS
  PDF
}

enum ImportStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

model ImportJob {
  id         String           @id @default(cuid())
  sourceType ImportSourceType
  sourceName String // e.g. "2026 BOGT AMZ Stock & Prices"
  tabName    String? // e.g. "All PRODUCTS STATS"
  status     ImportStatus     @default(PENDING)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  rowsRead    Int @default(0)
  rowsCreated Int @default(0)
  rowsUpdated Int @default(0)
  rowsSkipped Int @default(0)
  errorCount  Int @default(0)

  productsAdded     Int @default(0)
  productsUpdated   Int @default(0)
  newStockInTxns    Int @default(0)
  newStockOutTxns   Int @default(0)
  priceChanges      Int @default(0)
  stockChanges      Int @default(0)
  mappingErrors     Int @default(0)
  unmatchedProducts Int @default(0)

  summary Json?

  triggeredById String?
  triggeredBy   User?   @relation(fields: [triggeredById], references: [id])

  rows        ImportRow[]
  amazonStats AmazonStats[]
  invoiceTxns InventoryTransaction[]
  invoices    Invoice[]

  @@map("import_jobs")
}

model ImportRow {
  id               String    @id @default(cuid())
  importJobId      String
  importJob        ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber        Int
  rawData          Json
  status           String // OK | ERROR | SKIPPED | MATCHED | UNMATCHED
  matchedProductId String?
  errorMessage     String?
  createdAt        DateTime  @default(now())

  @@index([importJobId, status])
  @@map("import_rows")
}

enum MatchStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model MatchingQueue {
  id                 String      @id @default(cuid())
  candidateType      String // "supplier_upload" | "invoice" | "sheet_sync"
  rawIdentifier      String?
  rawTitle           String?
  rawBrand           String?
  suggestedProductId String?
  suggestedProduct   Product?    @relation(fields: [suggestedProductId], references: [id])
  confidence         String // HIGH | MEDIUM | LOW
  status             MatchStatus @default(PENDING)
  reviewedById       String?
  reviewedBy         User?       @relation(fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  createdAt          DateTime    @default(now())
  metadata           Json?

  @@map("matching_queue")
}

// =========================================================================
// GOOGLE SHEETS CONNECTIONS
// =========================================================================

enum SheetConnectionStatus {
  NOT_CONFIGURED
  CONNECTION_REQUIRED
  CONNECTED
  ERROR
}

model SheetConnection {
  id                 String                @id @default(cuid())
  workbookName       String                @unique // "2026 BOGT AMZ Stock & Prices" | "BOGT in Rover Live Stock 2026"
  spreadsheetId      String?
  status             SheetConnectionStatus @default(NOT_CONFIGURED)
  lastSuccessfulSync DateTime?
  lastAttemptAt      DateTime?
  lastError          String?
  autoSyncInterval   String                @default("MANUAL_ONLY") // MANUAL_ONLY | HOURLY_1 | HOURLY_3 | HOURLY_6 | HOURLY_12 | DAILY
  autoSyncEnabled    Boolean               @default(false)
  writeBackEnabled   Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  tabs SheetTabMapping[]

  @@map("sheet_connections")
}

model SheetTabMapping {
  id                String          @id @default(cuid())
  sheetConnectionId String
  sheetConnection   SheetConnection @relation(fields: [sheetConnectionId], references: [id], onDelete: Cascade)
  tabName           String // "All PRODUCTS STATS"
  targetEntity      String // "PRODUCT_MASTER" | "ROVER_MASTER_STOCK" | "STOCK_IN" | "STOCK_OUT" | ...
  headerRow         Int             @default(1)
  columnMap         Json // { "ASIN": "M", "Units Shipped T30": "N", ... } stored as header-name -> logical field
  status            String          @default("OK") // OK | SOURCE_MAPPING_ISSUE
  lastError         String?
  lastSyncedAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([sheetConnectionId, tabName])
  @@map("sheet_tab_mappings")
}

// =========================================================================
// SETTINGS (business rules, versioned)
// =========================================================================

model Setting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  history SettingChange[]

  @@map("settings")
}

model SettingChange {
  id          String   @id @default(cuid())
  key         String
  setting     Setting  @relation(fields: [key], references: [key], onDelete: Cascade)
  oldValue    Json?
  newValue    Json
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id])
  createdAt   DateTime @default(now())

  @@map("setting_changes")
}

// =========================================================================
// AUDIT LOG
// =========================================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  source      String? // "ui" | "import" | "sync" | "api"
  importJobId String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
