{
  "name": "bogt-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > /tmp/_push.sql && psql \"$DATABASE_URL\" -f /tmp/_push.sql",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-table": "^9.2.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "googleapis": "^178.0.0",
    "jose": "^6.2.11",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4",
